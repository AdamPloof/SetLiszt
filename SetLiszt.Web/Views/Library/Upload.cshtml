@using SetLiszt.Web.ViewModels
@using SetLiszt.Web.Models;

@model SongUploadViewModel

<div class="container">
    <h2>Upload Song</h2>
    <form asp.action="Login" method="post">
        <div class="form-content d-flex flex-column">
            <div class="mb-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
            <div class="w-100 d-flex flex-row mb-3 column-gap-4 align-items-end">
                <div class="form-group flex-grow-1">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group flex-grow-1">
                    <label asp-for="Artist"></label>
                    <input asp-for="Artist" class="form-control" />
                    <span asp-validation-for="Artist" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <select
                        asp-for="Transposition"
                        asp-items="Html.GetEnumSelectList<Song.Transposition>()"
                        class="form-select"
                    ></select>
                    <span asp-validation-for="Transposition" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <div class="input-group">
                    <input asp-for="File" class="form-control" />
                    <span asp-validation-for="File" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </form>
</div>
